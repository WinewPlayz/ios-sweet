+/* Original diagnostic logic. Register facts: NothingOSS sm7635/b/mr.
+ * No write interface, FIFO reads, bus commands, resets or clock changes.
+ * Clock gating is deliberately conservative: an OFF/unknown clock means skip.
+ */
+#ifndef ASTEROIDS_GENI_CORE_H
+#define ASTEROIDS_GENI_CORE_H
+#include <stdint.h>
+enum ag_state { AG_BAD_ARGUMENT=0, AG_READ_FAILED, AG_CLOCKS_OFF,
+    AG_NOT_SPI, AG_FIFO_DISABLED, AG_BUSY, AG_SPI_VISIBLE };
+enum { AG_GCC=0, AG_SE=1 };
+struct ag_snapshot {
+    uint32_t state, vote, clocks[5], registers[5];
+};
+typedef int (*ag_read_fn)(void *, unsigned, uint32_t, uint32_t *);
+static const uint32_t ag_clock_offsets[5]={0x23018,0x23008,0x23000,0x23004,0x18004};
+static const uint32_t ag_se_offsets[5]={0x68,0x64,0x40,0xe24,0xe28};
+static inline unsigned ag_capture(ag_read_fn read32, void *context, struct ag_snapshot *r)
+{
+    if (!r || !read32) return AG_BAD_ARGUMENT;
+    r->state=AG_READ_FAILED;r->vote=0;
+    for(unsigned i=0;i<5;i++){r->clocks[i]=0;r->registers[i]=0;}
+    if(!read32(context,AG_GCC,0x52008,&r->vote))return r->state;
+    for(unsigned i=0;i<5;i++)
+        if(!read32(context,AG_GCC,ag_clock_offsets[i],&r->clocks[i]))return r->state;
+    unsigned enabled=(r->vote&0x7c0000u)==0x7c0000u;
+    for(unsigned i=0;i<5;i++)if(r->clocks[i]&0x80000000u)enabled=0;
+    if(!enabled)return r->state=AG_CLOCKS_OFF;
+    for(unsigned i=0;i<5;i++)
+        if(!read32(context,AG_SE,ag_se_offsets[i],&r->registers[i]))return r->state;
+    if(((r->registers[0]>>8)&255)!=1)return r->state=AG_NOT_SPI;
+    if(r->registers[1]&1)return r->state=AG_FIFO_DISABLED;
+    if(r->registers[2]&1)return r->state=AG_BUSY;
+    /* Visibility only: does NOT establish rail power, FIFO suitability or touch. */
+    return r->state=AG_SPI_VISIBLE;
+}
+#endif
--- /dev/null
+++ b/iokit/Kernel/arm/hid/AsteroidsGENIProbe.h
@@ -0,0 +1,54 @@
+/* Opt-in Nothing Phone (3a) clock-gated, read-only controller snapshot.
+ * Include globally before SweetHIDTouch::start, after its normal kernel headers.
+ * Never call ml_probe_read: that symbol panics in the current SWEET kernel.
+ */
+#ifndef ASTEROIDS_GENI_PROBE_H
+#define ASTEROIDS_GENI_PROBE_H
+#include "AsteroidsGENICore.h"
+#ifndef ASTEROIDS_GENI_HOST_TEST
+#include <machine/machine_routines.h>
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+#endif
+static_assert(sizeof(ag_snapshot)==48,"Probe property ABI must remain 48 bytes");
+struct ag_xnu_context { vm_offset_t gcc, se; };
+static bool ag_probe_ran;
+static ag_snapshot ag_probe_result;
+static int ag_xnu_read(void *opaque,unsigned bank,uint32_t offset,uint32_t *value)
+{
+    ag_xnu_context *context=(ag_xnu_context *)opaque;
+    if(bank==AG_GCC){
+        if(offset!=0x52008 && offset!=0x23018 && offset!=0x23008 &&
+           offset!=0x23000 && offset!=0x23004 && offset!=0x18004)return 0;
+        if(!context->gcc)context->gcc=ml_io_map(0x00100000,0x60000);
+        if(!context->gcc)return 0;
+    }else if(bank==AG_SE){
+        if(offset!=0x68 && offset!=0x64 && offset!=0x40 && offset!=0xe24 && offset!=0xe28)return 0;
+        if(!context->se)context->se=ml_io_map(0x00a80000,0x4000);
+        if(!context->se)return 0;
+    }else return 0;
+    vm_offset_t base=bank==AG_GCC?context->gcc:context->se;
+#if defined(__aarch64__)
+    __asm__ volatile("dmb oshld" ::: "memory");
+#endif
+    *value=*(volatile uint32_t *)(base+offset);
+#if defined(__aarch64__)
+    __asm__ volatile("dmb oshld" ::: "memory");
+#endif
+    return 1;
+}
+static const ag_snapshot *asteroids_geni_probe_once(void)
+{
+    int enabled=0;
+    if(ag_probe_ran)return &ag_probe_result;
+    if(!PE_parse_boot_argn("asteroidstouchprobe",&enabled,sizeof(enabled)) || enabled!=1)return 0;
+    ag_probe_ran=true;
+    ag_xnu_context context={0,0};
+    ag_capture(ag_xnu_read,&context,&ag_probe_result);
+    const ag_snapshot &result=ag_probe_result;
+    static const char *const states[]={"BAD ARGUMENT","READ FAILED","CLOCKS OFF - CONTROLLER SKIPPED","NOT SPI","FIFO DISABLED","BUSY","SPI VISIBLE - NO TOUCH TRANSACTION"};
+    IOLog("ASTEROIDS TOUCH PROBE: %s vote=%#x\n",states[result.state],result.vote);
+    IOLog("ASTEROIDS TOUCH PROBE: clocks=%#x,%#x,%#x,%#x,%#x\n",result.clocks[0],result.clocks[1],result.clocks[2],result.clocks[3],result.clocks[4]);
+    IOLog("ASTEROIDS TOUCH PROBE: fw=%#x iface=%#x status=%#x txhw=%#x rxhw=%#x\n",result.registers[0],result.registers[1],result.registers[2],result.registers[3],result.registers[4]);
+    return &ag_probe_result;
+}
+#endif
